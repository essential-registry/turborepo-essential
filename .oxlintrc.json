{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  },
  "env": { "builtin": true, "browser": true, "node": true },
  "ignorePatterns": [
    ".next",
    ".vercel",
    ".husky",
    ".turbo",
    "build",
    "dist",
    "node_modules"
  ]
}